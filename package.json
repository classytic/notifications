{
  "name": "@classytic/notifications",
  "version": "2.7.0",
  "description": "Multi-channel notifications (Email, SMS, Push, Webhook, Telegram) with rate limiting, delivery tracking, queue adapters, channel fallback, templates, retry — zero required dependencies",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./channels": {
      "types": "./dist/channels/index.d.mts",
      "default": "./dist/channels/index.mjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.mts",
      "default": "./dist/providers/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "default": "./dist/utils/index.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "channels": ["./dist/channels/index.d.mts"],
      "providers": ["./dist/providers/index.d.mts"],
      "utils": ["./dist/utils/index.d.mts"]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "notifications",
    "multi-channel",
    "email",
    "sms",
    "push-notifications",
    "webhook",
    "telegram",
    "nodemailer",
    "smtp",
    "ses",
    "rate-limiting",
    "delivery-tracking",
    "queue",
    "channel-fallback",
    "templates",
    "retry",
    "idempotency",
    "pluggable",
    "framework-agnostic",
    "typescript",
    "zero-dependencies"
  ],
  "author": "Classytic <classytic.dev@gmail.com> (https://github.com/classytic)",
  "contributors": [
    "Sadman Chowdhury (https://github.com/siam923)"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classytic/notifications.git"
  },
  "bugs": {
    "url": "https://github.com/classytic/notifications/issues"
  },
  "homepage": "https://github.com/classytic/notifications#readme",
  "peerDependencies": {
    "nodemailer": ">=6"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:consumer",
    "typecheck:consumer": "tsdown --logLevel warn && tsc --noEmit -p tsconfig.types.json",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "push": "classytic-push",
    "publish:dry": "npm publish --dry-run --access public",
    "publish:npm": "npm publish --access public",
    "release": "npm run build && npm run typecheck && npm test && npm publish --access public",
    "release:patch": "npm version patch && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:major": "npm version major && npm run release"
  },
  "devDependencies": {
    "@classytic/dev-tools": "^0.2.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "nodemailer": "^10.1.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
